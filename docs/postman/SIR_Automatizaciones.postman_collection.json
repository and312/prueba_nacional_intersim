                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"solicitudId\": 1,\n  \"resumenEjecutivoRol\": {\n    \"resumen\": \"El Gerente de TI liderará la transformación tecnológica de la compañía, coordinando las áreas de desarrollo, infraestructura y seguridad informática.\",\n    \"objetivoCargo\": \"Garantizar la disponibilidad de los sistemas e impulsar iniciativas ágiles de digitalización.\",\n    \"funcionesPrincipales\": [\n      \"Diseñar y ejecutar el plan estratégico de tecnología.\",\n      \"Liderar y capacitar al equipo de ingenieros de software.\",\n      \"Negociar contratos con proveedores tecnológicos.\"\n    ],\n    \"requisitosMinimos\": [\n      \"Título profesional en Ingeniería de Sistemas, Telecomunicaciones o ramas afines.\",\n      \"Mínimo 5 años de experiencia liderando áreas de TI.\"\n    ],\n    \"formacionExperiencia\": \"Licenciatura culminada y deseable maestría en Administración de TI o Dirección de Proyectos.\",\n    \"hardSkills\": [\n      \"Arquitectura en la nube (AWS/Azure)\",\n      \"Metodologías Ágiles (Scrum, Kanban)\",\n      \"Gobernanza de Datos e ITIL\"\n    ],\n    \"softSkills\": [\n      \"Liderazgo estratégico\",\n      \"Negociación asertiva\",\n      \"Resolución de problemas complejos\"\n    ],\n    \"modalidad\": \"Híbrido\",\n    \"ubicacion\": \"Santa Cruz de la Sierra - Oficina Central\",\n    \"bandaSalarial\": \"Bs. 15,000 - 20,000\",\n    \"criteriosEvaluacion\": \"Evaluación técnica de arquitectura de nube, caso práctico de gestión ágil y entrevista por competencias.\",\n    \"caracteristicasClave\": \"Buscamos un perfil dinámico, orientado a resultados y facilitador del cambio cultural.\",\n    \"valoracionPerfil\": \"Crítico e indispensable para el plan estratégico anual de transformación.\"\n  }\n}"
